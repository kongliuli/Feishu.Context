<Window x:Class="Feishu.Context.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Feishu.Context"
        Title="飞书上下文工具 - Feishu.Context"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="MainTabControl"
                    Margin="8">
            <!-- 飞书采集 Tab -->
            <TabItem Header="飞书采集">
                <ContentControl x:Name="FeishuCollectionContent"
                                Margin="8">
                    <TextBlock Text="飞书采集功能模块 - 待实现"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray" />
                </ContentControl>
            </TabItem>

            <!-- API 调度 Tab -->
            <TabItem Header="API 调度">
                <ContentControl x:Name="ApiSchedulingContent"
                                Margin="8">
                    <TextBlock Text="API 调度功能模块 - 待实现"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray" />
                </ContentControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
