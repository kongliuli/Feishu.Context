<Window x:Class="Feishu.Context.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Feishu.Context"
        xmlns:views="clr-namespace:Feishu.Context.Views"
        Title="飞书上下文工具 - Feishu.Context"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="MainTabControl"
                    Margin="8">
            <!-- 飞书采集 Tab -->
            <TabItem Header="飞书采集">
                <views:FeishuView />
            </TabItem>

            <!-- API 调度 Tab -->
            <TabItem Header="API 调度">
                <views:ApiView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
