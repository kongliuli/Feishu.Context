<UserControl x:Class="Feishu.Context.Views.ApiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Feishu.Context.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: API Configuration -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Config List -->
                <GroupBox Header="API 配置列表" Grid.Row="0" Margin="4">
                    <DataGrid ItemsSource="{Binding ApiConfigs}"
                              SelectedItem="{Binding SelectedApiConfig}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="50" />
                            <DataGridTextColumn Header="间隔(秒)" Binding="{Binding ScheduleIntervalSeconds}" Width="60" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Config Edit Form -->
                <GroupBox Header="配置编辑" Grid.Row="1" Margin="4">
                    <StackPanel Margin="4">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="URL:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ConfigUrl, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="方法:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Text="{Binding ConfigMethod, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Margin="4,0">
                                <ComboBoxItem Content="GET" />
                                <ComboBoxItem Content="POST" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Headers:" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Column="1" Text="{Binding ConfigHeaders, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="4,0"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Body:" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Column="1" Text="{Binding ConfigBody, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="4,0"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="间隔(秒):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ConfigInterval, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
                        </Grid>

                        <!-- Action Buttons -->
                        <UniformGrid Columns="3" Margin="0,6,0,2">
                            <Button Content="添加配置" Command="{Binding AddConfigCommand}" Margin="2" Padding="4" />
                            <Button Content="更新配置" Command="{Binding UpdateConfigCommand}" Margin="2" Padding="4" />
                            <Button Content="删除配置" Command="{Binding DeleteConfigCommand}" Margin="2" Padding="4" />
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,2">
                            <Button Content="手动执行" Command="{Binding ExecuteCommand}" Margin="2" Padding="4" />
                            <Button Content="启动/停止调度" Command="{Binding ToggleScheduleCommand}" Margin="2" Padding="4" />
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray" />

            <!-- Right Panel: Schedule Records -->
            <GroupBox Header="调度执行记录" Grid.Column="2" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="刷新记录" Command="{Binding RefreshRecordsCommand}" Margin="0,0,4,0" Padding="8,2" />
                        <Button Content="刷新配置" Command="{Binding RefreshConfigsCommand}" Padding="8,2" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ScheduleRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="API名称" Binding="{Binding ApiName}" Width="80" />
                            <DataGridTextColumn Header="请求URL" Binding="{Binding RequestUrl}" Width="150" />
                            <DataGridTextColumn Header="状态码" Binding="{Binding StatusCode}" Width="55" />
                            <DataGridCheckBoxColumn Header="成功" Binding="{Binding IsSuccess}" Width="40" />
                            <DataGridTextColumn Header="执行时间" Binding="{Binding ExecutedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="130" />
                            <DataGridTextColumn Header="响应内容" Binding="{Binding ResponseBody}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="执行中..." VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}" />
                    <ProgressBar IsIndeterminate="True" Width="80" Height="12"
                                 Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
