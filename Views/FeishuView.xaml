<UserControl x:Class="Feishu.Context.Views.FeishuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:Feishu.Context.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FeishuViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- WebView2 区域 -->
        <Border Grid.Row="0"
                BorderBrush="#DDD"
                BorderThickness="1"
                Margin="4">
            <wv2:WebView2 x:Name="FeishuWebView"
                          Source="about:blank" />
        </Border>

        <!-- 控制面板 -->
        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,1"
                Background="#F9F9F9"
                Padding="8">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="会话 ID："
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <TextBox Text="{Binding ChatId, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
                <Button Content="登录飞书"
                        Command="{Binding LoginCommand}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <Button Content="采集消息"
                        Command="{Binding CollectCommand}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <Button Content="刷新记录"
                        Command="{Binding RefreshMessagesCommand}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 消息列表 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding CollectedMessages}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="会话名称"
                                    Binding="{Binding ChatName}"
                                    Width="120" />
                <DataGridTextColumn Header="发送者"
                                    Binding="{Binding SenderName}"
                                    Width="100" />
                <DataGridTextColumn Header="消息内容"
                                    Binding="{Binding Content}"
                                    Width="*" />
                <DataGridTextColumn Header="消息时间"
                                    Binding="{Binding MessageTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="140" />
                <DataGridTextColumn Header="采集时间"
                                    Binding="{Binding CollectedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="140" />
                <DataGridTemplateColumn Header="操作"
                                        Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除"
                                    Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Padding="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
